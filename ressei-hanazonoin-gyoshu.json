 "poems": [
  {
   "seq": "1",
   "text": "身につもる數こそかはれたちかへり今年も同じ春はきにけり",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "四方のこずゑ霞むを見ればまだきより花の心ぞはや匂ひける",
   "kana": "",
   "speaker": "",
   "page": 173,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "まだ咲かぬ梅の梢にうぐひすののどけきこゑは今ぞきこゆる",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "春の日ののどけきそらはくれがたみいたづらに聞く鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "夕ぐれの春風ゆるみしだりそむる柳がすゑはうごくともなし",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "のどかなる睦月の今日の雨の音に春の心ぞふかくなりぬる",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "淺みどりみじかき草の色ぬれてふるとしもなき庭の春さめ",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "夕がすみ霞みまさると見るままに雨になりゆくいり相の空",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "何事をうれふとなしにのどかなる春の雨夜は物ぞわびしき",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "花も見ず鳥をもきかぬ雨の中のこよひの心なにぞはるなる",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "野邊にして草のみどりのすゑとほみ霞をわけて雲雀おつなり",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "散ることは早しと思ふを櫻花ひらくるほどのあやにひさしき",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "軒深き花のかをりに霞まれてしらみもやらぬやどのあけぼの",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "くれかかる花の匂をしたひ顏にさらにうつろふ夕日かげかな",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "春風は吹くとしもなき夕ぐれにこずゑの花ものどかにぞちる",
   "kana": "",
   "speaker": "",
   "page": 174,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "立ちかふる今日ともいさやしら重昨日の花もそめぬ袂は",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "なれもまたこの夕暮をまちけりな初音うれしきやまほととぎす",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "思ふことありあけの空のほととぎすわが爲とてや今きなくらむ",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "待ち出づる雲間の月にほととぎすをしむ初音もえやは忍ばぬ",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "都人さこそまつともほととぎすおなじみ山のともなわすれそ",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "夏山や木立すずしきむらさめのゆふべを時となくほととぎす",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "五月雨ははれむとやする山の端にかかれる雲の薄くなりゆく",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "秋の夜をさびしきものと何か思ふ水鷄こゑする宵のつきかげ",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "ふくる夜のにはの眞砂は月しろし木蔭ののきに水鷄こゑして",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "ともしするほぐしの松のつきもあへずは山が嶺は雲あけぬなり",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "とぶ螢ともし火のごともゆれども光を見ればすずしくもあるか",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "庭の上の眞砂にみちて照れる日の影みるなべにあつさまさりぬ",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "蚊遣火の煙まさると見るほどにくれぬるならしいりあひの聲",
   "kana": "",
   "speaker": "",
   "page": 175,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "吹き過ぐる梢の風のひとはらひこゑまで凉しよそのゆふだち",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "とほつ空に夕だつ雲を見るなべにはやこの里も風きほふなり",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "みそぎ川流れて早くすぐる日のけふ六月は夜もふけにけり",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "花もまだき草のまがきの朝ぼらけ露のけしきに秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "夕日さす梢のいろに秋見えてそとものもりにひぐらしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "秋はまだあさけの庭の池の面にはやすさまじき水のいろかな",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "時わかぬ竹の小枝にふく風のおとしもあきになりにけるかな",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "いとはやも風すさまじみそれとなき蟲も籬にややなきたちぬ",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "目にちかき面影ながら年もへぬ雲井のにはのほしあひのあき",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "鶴の渡せる橋のひまをとほみあはぬ絕間のおほくもあるかな",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "大方の秋てふ秋のながき夜をこよひともがなほしあひのそら",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "更けぬるか水かげぐさのうち靡き凉しくなりぬあまの川かぜ",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "あまの川かはべの霧のふかき夜につまむかへ船今か出づらし",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "世の色のあはれは深くなりにけり秋は幾日も未だあらなくに",
   "kana": "",
   "speaker": "",
   "page": 176,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "秋風の軒端の荻よ何ぞこのうれへのたねをうゑおきにける",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "身こそあらめ花は昔をわするなよなれし戶口の庭のあきはぎ",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "穂に出でてわれのみ招く絲すすきくる人あれなふるさとの秋",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "物ごとにわれをいたむるゆゑはあらじ心なりけり秋の夕ぐれ",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "沈む日のよわきひかりはかべに消えて庭すさまじき秋風の音",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "秋かぜによわき尾花は動けども月にのどけみ更けすめる夜半",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "秋になる寐覺ぞいとどうれはしき物思ふ身にはありもあらずも",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "夜を寒みいねずてあれば月影のくだれるかべにきりぎりすなく",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "月すみて風はたさむき秋の夜のまがきの草にむしのこゑごゑ",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "きりぎりす聲かすかなり曉のかべにすくなきありあけの影",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "風の音も身にしむ夜半の秋の月ふけてひかりぞなほまさりゆく",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "くるる空にまちつるままの眺よりすだれおろさぬ月の夜すがら",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "照すらむ千里の人の秋のおもひ月にやうつすかげのかなしき",
   "kana": "",
   "speaker": "",
   "page": 177,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "咲きやらでしばしもあれな庭の菊待つべき花のまたもあらなくに",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "ちりつもる庭の紅葉ばのころとも秋の日數はとまりしもせじ",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "うつろはで庭の白菊のこらなむ秋のかたみとあすよりは見む",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "木の葉ぬれてそそぐともなき村時雨さすや夕日の影もさながら",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "木の葉こそもろくもならめ夕あらしわが淚さへたえずもある哉",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "散りまがふ木の葉にもろき音よりも枯木吹きとほす風ぞ淋しき",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "冬をあさみまだこほらねど風さえて漣さむきいけの面かな",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "この夜半やふけやしぬらむ霜深きかねの音して床さえ勝る",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "空はしも曇ると見えぬあさあけの霜にうすぎる世の氣色哉",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "それと見し霜の朽葉もなほ落ちて古枝ばかりの庭のはぎはら",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "雪はまだき唯冬枯の草のいろのおもがはりせぬ庭ぞさびしき",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "あかしかぬる時雨のねやのいく寐覺さすがに鐘の聲ぞきこゆる",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "影うすき有明のつきになくとりの聲さへしづむ霜のをちかた",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "霜にとほる鐘のひびきを聞くなべに寐覺のまくらさえ勝るなり",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "霜にくもる有明がたのつきかげにとをちの鐘もこゑしづむなり",
   "kana": "",
   "speaker": "",
   "page": 178,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "ひびき殘るとをちの鐘はかすかにて霜にうすぎる曙のそら",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "おきてみねど霜深からし人の聲の寒してふ聞くも寒き朝あけ",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "夜もすがら雪やと思ふ風の音に霜だにふらぬ今朝のさむけさ",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "あらし吹き霰こぼるる今日のくれ雪のこころや近づきぬらし",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "霜がれの尾花がにはに風ふれてさむきゆふ日は影さしぬなり",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "霜のおくねぐらの梢寒からしそとものもりに夜がらすのなく",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "星きよきこずゑの嵐くもはれて軒のみしろきうすゆきの夜半",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "夜半さむみ嵐の音はせぬにしもかくてや雪のふらむとすらむ",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "雲こほるこずゑの空の夕月夜あらしにみがく影もさむけし",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "むらむらにこほれる雲は空さえて月影みがく木木の白雪",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "さえくらす嵐に雪やちかからしさきだつあられ軒におつなり",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "野山みな草木もわかず花のさくゆきこそ冬のかざりなりけれ",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "冬がれの草木のときをあはれとや花をあまねくふれるしら雪",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "雲のゆふべ嵐のこよひふりそめぬ明けなば重の幾重かも見む",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "朝日さす松のうれよりおつる雪に消えがたにしも積る木の本",
   "kana": "",
   "speaker": "",
   "page": 179,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "目に近き軒の上より白みそめてこずゑかをれる雪のあけぼの",
   "kana": "",
   "speaker": "の野山は夜ふかきにあくるか鳥の遠里のこゑ",
   "page": 180,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "うつりにほふ雪の梢のあさ日かげいまこそ花の春はおぼゆれ",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "軒の上はうす雪しろし降りはるる空には星の影きよくして",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "吹きみだしはらひもあへぬ竹の葉のあらしの上につもる白雪",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "今朝の雨のなごりの雲やこほるらむくれゆく空の雪になりぬる",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "ながめやるかぎりも見えず霞みゆく野原がすゑは雪としもなし",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "雪にだにつれなくてやは山城のときはの森も色かはるなり",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "人はとはぬみ山の庵にあはれなほところもわかず降れる白雪",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "たのむゆゑの深き心はへだてぬをいつかみかさの山のしら雪",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "常磐木のその色となき雪の中も松はまつなるすがたぞみゆる",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "降りつもる雪のこずゑにゐる鳥の羽風もをしき庭のあさあけ",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "おき出でぬねやながら聞くいぬの聲の雪におぼゆる雪の朝明",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "いたづらにふる白雪を集めもたぬわが光なみ世さへくもれる",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "昔をばうづみやのこす白雪のふりにし世のみうかぶ面影",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "立ちのぼる煙のすゑをあはれとも誰れかはとはむ小野の炭竈",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "わきてしも惜むとなしに哀なり今年もかくて暮れぬと思へば",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "年くると世はいそぎたつ今宵しものどかに物のあはれなる哉",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "知らざりし眺やなにぞよしなしに物思ふ身にはならじと思ふを",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "人まなみ唯にはいはぬそこの色を見知らぬにして過ぎむとやする",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "わが心われに隨ふものならばつらき人をば戀ひずもあらまし",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "むば玉の夜渡る月のよそにのみ影ばかり見てやまむとやする",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "思ひたえてまたぬも悲し待つもくるし忘れつつある夕暮もがな",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "あすのうさも我が心から悲しきに今宵よこよひとへやとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "待つもとふもつつむにふくる時のまよあぢきなからぬ一夜ともがな",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "賴めしも忘れむと思ふけふの日をくるとなつげそ入相のかね",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "わが思なぐさまなくに何しかもこぬものゆゑに賴めおきけむ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "あかなくの今朝の名殘のなぐさめに知らぬ人をもまた賴めぬる",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "これほどもまたはいつかの別路をくれよのちよのやすの賴めや",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "うしと見し一夜の夢の名殘よりこころにさめぬ物をこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "いまぞ思ふたのみしうちのいくあはれかざるが上の情なりける",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "うきがうへに歎くぞなほもあはれなる誓ひし末を人のためとて",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "うきにたへず恨むればまた人も恨む契のはてよただかくしこそ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "かひあらじいはじよしとは思へども今一たびは恨みてもみむ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "ひとすぢに思ひしらぬになしやするいはぬ恨も同じつらさを",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "をしやわれもあはれかなしのいくふしを一つ恨のうちになしぬる",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "われやたそ怪しやつひにたえはてばあらじと思ふ今日までの身よ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "うしとすつる身を思ふにもさらになほあはれなりける人の契よ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "あさくしもなぐさむるかなと聞くからに恨の底ぞなほ深くなる",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "こひあまりわがなく涙雨とふるやこのくれしもの雲とづる空",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "思ひつくす思のゆくへつくづくと涙ぞおつるともし火のかげ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "思ひつくしあはれに物のなりたちてすべて涙の落ちもとまらぬ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "里の犬のこゑをきくにも人知れずつつみし道の夜半ぞこひしき",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "色音にもうれへのすすむ種としてわれにものうき花鳥のはる",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "とぢつもるこほりも雪も冬のみをとけむごもなき我が思かな",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "いまもこの有明の空に鳥はなけど別れし人に又もあはぬかな",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "いかになる今朝のながめぞ今宵わが見るとしもなき夢の名殘に",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "西の山にくだる夕日の影みれば今日はたくれぬいもを見なくに",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "照る月はわが思ふ人のなになれや影をし見れば物のかなしき",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "なにぞこのうはの空より吹く風の身にあたるさへ物の悲しき",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "妹が上に思ひうらぶれねずてあかすこの夜すがらの雨の音はも",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "朝霜のむすびもはてぬ契ゆゑさてこそけなめ知る人をなみ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "あま人のもしほの煙なびくやとおもふかたより風も吹かなむ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "わが戀よ煙もせめてたちななむなびかぬまでも君にみゆべく",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "あはれいまはかくて契やつくばやましげき恨のわれもそふ頃",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "妹まつと時ぞともなきながめしてよもぎが庭も霜がれにけり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "人やうきさも岩代のむすび松むすばぬ世世の身のちぎりこそ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "わかれましつらからましと聞くもつらし八聲の鷄の明方の聲",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "月になくやもめがらすはわが如くひとり寐がたみ妻やこひしき",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "人知れずわがたちすまむ宿のあたりとがむる犬もせめてなつかし",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "思ひとりしその僞のならひゆゑ人にもひとのなほ賴まれぬ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "ゆきて通ふ夢てふもののあるならば今宵の心見えざらめやも",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "うきはさぞなあはれなるさへくるしきよ人に心のなべてならなむ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "人を思ふ世にふりざらむ言の葉の君にはじめていはまほしきを",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "思ふ色のいはれぬきはをうつし見せむ鏡もがなや君が心に",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "戀しとてかへさむとはたおもほえず重ねしままの夜の衣を",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "さぞやげに我れぞつれなきまちよわる明方の窓にきゆるともし火",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "見しぞかしかかる言の葉そのふしと更になみだもふるき玉章",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "いとせめて忍ぶる中の玉章は思ふかぎりをかきもつくさず",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "つらきをもげに思ひ知る中ならばいとかく人をしたはざらまし",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "戀しきは忍びがたきをいかがせむうきは身を知る慰もあり",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "ながれてのその世がたりの名取川かりの逢瀨に身をば沈めじ",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "戀といふ名のみはなべてふりぬめり我が思をばいかがいはまし",
   "kana": "",
   "speaker": "",
   "page": 185,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "足引の山をうき世のへだてにて塵のさかひにあとは絕えにき",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "雲の色ほしの光もおなじ空ののどかになるやあかつきになる",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "風になびく竹のむらむら末見えて夕日にはるる遠のやまもと",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "ももしきや庭に見なれしくれ竹の短き世こそなほあはれなれ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "とまる名は長柄の橋の橋ばしらくちてのちしもなほ殘りける",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "世世を經てみゆきふりにし宿の花かはらぬ色も昔こふらし",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "いつとてもおなじ空ゆく月のなど春はおぼろに秋はさやけき",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "今は身のよそにへだつる秋霧のたち野の駒はけふかひくらむ",
   "kana": "",
   "speaker": "",
   "page": 186,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "鳥かへるそともの森のかげくれて夕のそらは雲ぞのどけき",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "さ夜ふくる窓のともし火つくづくと影も靜けし我れもしづけし",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "過ぎにし世今ゆく先と思ひうつる心よいづらともし火のもと",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "むかひなす心に物やあはれなるあはれにもあらじ燈火のかげ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "更くる夜の燈火の影をおのづから物のあはれに向ひなしぬる",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "心とてよもにうつるよ何ぞこれただこの向ふともし火のかげ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "庭の日は木蔭も見えずてりみちて風さへぬるみくれ難きころ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "我れもさぞあすともなしの今日の世にあればあるてふささがにの露",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "時にふるるなさけのうちも心すむは月にしらぶる絲竹のこゑ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "をりみだれ四方の山邊に雲もみちのかぜはげしみ雨になる暮",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "ふる里やちぐさが庭のはなのあき垣根の露にまつむしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 187,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "今年またはかなく過ぎて秋もたけかはる草木の色もすさまじ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "月影はまだ中空にのどけきをはやとりきこゆ明けぬこの夜は",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "難波がた波路はれゆく夕なぎに入日まぢかきあはぢしまやま",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "こゆれども同じ山のみかさなりて過ぎゆく旅の道ぞはるけき",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "太山路をゆふこえくれて宿もなし雲ゐる峯にこよひかもねむ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "旅にして妹をこひしみ眺め居れば都のかたにくもたなびけり",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "かへり見る都やいづこ和田の原くもの波路ははても知られず",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "尋ねくる人も音せぬ柴の戶にあけくれきくはみねのまつかぜ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "有明の月こそありけれみ山邊にわれのみ獨すむかとおもへば",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "聞き侘びぬ枕の山の夜のあらし世のうきよりは住みよけれども",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "常磐木のしげき綠の下にして日かげも見えぬたにかげのやど",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "軒につづく檜原が山に雲おりてくるるこずゑに雨おちそめぬ",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "おのづから人にそむける心にてつひに憂世のちりをいでぬる",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "伏見山かど田のすゑは明けやらで松のこなたの空ぞしらめる",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "ただしきをうけつたふべき跡にしもうたても迷ふ敷島のみち",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "舟もなく筏も見えぬおほかはにわれわたり得ぬ道ぞくるしき",
   "kana": "",
   "speaker": "",
   "page": 188,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "夜をのこすまくらの上の鐘の音に五十ぢの夢ぞあはれみじかき",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "蘆原やみだれし國の風をかへて民の草葉もいまなびくなり",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "年ふりて世をうみ渡る葦田鶴のなほたちまじる和歌の浦波",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "今はわがむなしきふねのつながれぬ心にのこす心ともなし",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "忍ぶべき昔はさりななにとなく過ぎにし事のなぞあはれなる",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "何となく過ぎにし方ぞあはれなる昔もおなじゆめの世なれど",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "199",
   "text": "花のうちに遊ぶ胡蝶の百年よさむるうつつはなほやみじかき",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "200",
   "text": "朝顏の花はまがきにうゑて見む常ならぬ世をおもひ知るやと",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "201",
   "text": "色深き袖の淚にならふらしちしほやちしほそむるもみぢ葉",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "202",
   "text": "いたづらに苦しき海にしづみなば法の浮木にまたもあはめやも",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "203",
   "text": "いとふとも惜むともなにかりそめの憂世にやどる我が身と思へば",
   "kana": "",
   "speaker": "",
   "page": 189,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "204",
   "text": "賴むまことふたつなければ石〓水ひとつ流にすむかとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "205",
   "text": "祈る心わたくしにては石〓水にごりゆく世をすませとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "206",
   "text": "百敷にうつしうゑてぞ色そはむはこやの山の千世のくれたけ",
   "kana": "",
   "speaker": "",
   "page": 190,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  }
 ],
